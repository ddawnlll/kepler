#!/bin/sh
# /usr/local/sbin/kepler-set-secret: gizli değeri sohbete/komut satırına yazmadan, terminalden sessiz okuyup ilgili kullanıcının env dosyasına koyar.
# Kullanım (jj/admin olarak, TTY ile):  ssh -t a 'sudo kepler-set-secret <kullanıcı> <ev-dizinine-göre-dosya> <DEĞİŞKEN>'
#   örn: sudo kepler-set-secret kagent .hermes/.env TELEGRAM_BOT_TOKEN
# Güvenlik: dosyaya YAZMA hedef kullanıcı olarak yapılır (runuser); root, kullanıcının kontrolündeki bir yolu (symlink) izleyip yazmaz/okumaz.
# Değer argv'ye girmez: tty'den okunur, hedef kullanıcıya stdin ile geçer.
set -eu
[ "$#" = 3 ] || { echo "kullanım: $0 <kullanıcı> <dosya> <DEĞİŞKEN>" >&2; exit 2; }
u=$1; f=$2; v=$3
case "$u" in kagent|krunner) ;; *) echo "yalnızca kagent veya krunner" >&2; exit 2 ;; esac
case "$v" in ''|*[!A-Za-z0-9_]*) echo "geçersiz değişken adı" >&2; exit 2 ;; esac
case "$f" in /*|*..*) echo "dosya ev dizinine göre olmalı" >&2; exit 2 ;; esac
home=$(getent passwd "$u" | cut -d: -f6); [ -d "$home" ] || { echo "kullanıcı yok: $u" >&2; exit 2; }
runuser -u "$u" -- test -d "$(dirname "$home/$f")" || { echo "hedef dizin yok: $(dirname "$home/$f")" >&2; exit 2; }
trap 'stty echo </dev/tty 2>/dev/null || true' EXIT
printf '%s (görünmez): ' "$v" >&2; stty -echo </dev/tty; IFS= read -r val </dev/tty; stty echo </dev/tty; printf '\n' >&2
[ -n "$val" ] || { echo "boş değer, iptal" >&2; exit 1; }
printf '%s\n' "$val" | runuser -u "$u" -- sh -c '
  set -eu; umask 077
  path=$1; v=$2; IFS= read -r val
  tmp=$(mktemp "$path.XXXXXX"); trap "rm -f \"$tmp\"" EXIT
  { grep -v "^$v=" "$path" 2>/dev/null || true; printf "%s=%s\n" "$v" "$val"; } > "$tmp"
  chmod 600 "$tmp"; mv "$tmp" "$path"; trap - EXIT
' sh "$home/$f" "$v"
echo "yazıldı: $home/$f ($v, ${#val} karakter)" >&2
