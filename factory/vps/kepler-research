#!/usr/bin/python3
"""Root-owned launcher for the credential-isolated DEV-only Modal submitter."""
import json
import os
import re
import subprocess
import sys

if len(sys.argv) != 4 or not re.fullmatch(r"[0-9a-f]{32}", sys.argv[1]) or not re.fullmatch(r"[0-9a-f]{40}", sys.argv[2]):
    raise SystemExit("geçersiz araştırma token/commit")
payload = json.loads(sys.argv[3])
if set(payload) != {"script", "argv"} or len(sys.argv[3]) > 8192:
    raise SystemExit("geçersiz araştırma payload")
config = json.load(open("/etc/kepler/policy.json"))
if not config["research_enabled"] or not all(config.get(k) is True for k in ("dev_workspace_verified", "provider_limits_verified", "acceptance_verified")) or payload["script"] not in config["research_scripts"]:
    raise SystemExit("araştırma kapalı/betik yasak")
if not isinstance(payload["argv"], list) or any(not isinstance(a, str) or len(a) > 128 for a in payload["argv"]):
    raise SystemExit("argv sınırı")
allowed = {"--stage", "--job", "--preset", "--expert", "--rot", "--b", "--null-from", "--null-to", "--only", "--syms", "--procs"}
argv = payload["argv"]
if not argv or len(argv) > 24 or len(argv) % 2 or len(set(argv[::2])) != len(argv[::2]):
    raise SystemExit("argv şeması")
for key, value in zip(argv[::2], argv[1::2]):
    if key not in allowed or not re.fullmatch(r"[A-Za-z0-9_,.-]{1,128}", value):
        raise SystemExit("argv filtresi")
    if key in {"--b", "--null-from", "--null-to", "--procs"} and (not value.isdigit() or int(value) > 1000):
        raise SystemExit("sayısal sınır")
os.environ.clear()
os.environ.update(PATH="/usr/bin:/bin", HOME="/root")
token, commit = sys.argv[1:3]
cmd = ["/usr/bin/systemd-run", "--quiet", "--wait", "--collect", "--pipe", "--unit=kepler-job-" + token,
       "--uid=kcompute", "--gid=kepler-results", "--service-type=exec",
       "--property=RuntimeDirectory=kepler-job-" + token, "--property=WorkingDirectory=/run/kepler-job-" + token,
       "--property=RuntimeDirectoryMode=0700", "--property=EnvironmentFile=/etc/kepler/modal.env",
       "--property=StateDirectory=kepler-results/" + token, "--property=StateDirectoryMode=0750",
       "--property=NoNewPrivileges=yes", "--property=PrivateTmp=yes", "--property=ProtectHome=yes",
       "--property=ProtectSystem=strict", "--property=ProtectKernelTunables=yes", "--property=ProtectKernelModules=yes",
       "--property=ProtectControlGroups=yes", "--property=PrivateDevices=yes", "--property=ProtectProc=invisible",
       "--property=RestrictSUIDSGID=yes", "--property=CapabilityBoundingSet=", "--property=KillMode=control-group",
       "--property=RuntimeMaxSec=" + str(config["timeout_seconds"]),
       "--property=BindReadOnlyPaths=/srv/kepler.git:/input/repo.git",
       "--property=InaccessiblePaths=/srv /home /root /run/kepler",
       "--setenv=HOME=/run/kepler-job-" + token, "--setenv=PYTHONNOUSERSITE=1",
       "/opt/kepler/venv/bin/python", "-I", "/usr/local/libexec/kepler-research-worker", commit, token, json.dumps(payload)]
raise SystemExit(subprocess.run(cmd).returncode)
