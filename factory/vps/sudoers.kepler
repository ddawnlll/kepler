# /etc/sudoers.d/kepler: kagent'in krunner olarak yapabildikleri (docs/factory.md §5.3).
kagent ALL=(krunner) NOPASSWD: /usr/local/sbin/kepler-receive-pack /srv/kepler.git
# Agents have NO sudo queue, shell, worker or credential access; use SO_PEERCRED broker.
# Only the trusted runtime may invoke fixed root-owned launchers; each validates all argv.
krunner ALL=(root) NOPASSWD: /usr/local/sbin/kepler-sandbox *, /usr/local/sbin/kepler-research *
