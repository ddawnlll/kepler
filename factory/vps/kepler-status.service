# /etc/systemd/system/kepler-status.service: deterministik durum özeti (LLM yok), krunner olarak. Zamanlayıcı: kepler-status.timer
[Unit]
Description=Kepler durum özeti (factory.status -> state/STATUS.md)

[Service]
Type=oneshot
User=krunner
WorkingDirectory=/srv/kepler
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/srv/kepler/state
UMask=0027
ExecStart=/opt/kepler/venv/bin/python -m factory.status "ledger/**/*.jsonl" --runtime --out state/STATUS.md
