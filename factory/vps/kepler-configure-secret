#!/bin/bash
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
    echo "sudo ile çalıştırılmalı" >&2
    exit 1
fi

case "${1:-}" in
    modal)
        target=/etc/kepler/modal.env
        printf 'Modal DEV token ID: '
        IFS= read -r token_id
        printf 'Modal DEV token secret: '
        IFS= read -r -s token_secret
        printf '\n'
        [[ "$token_id" =~ ^[A-Za-z0-9._-]+$ && "$token_secret" =~ ^[A-Za-z0-9/+_=-]+$ ]] || { echo "beklenmeyen anahtar biçimi" >&2; exit 1; }
        content=$(printf 'MODAL_TOKEN_ID=%s\nMODAL_TOKEN_SECRET=%s\n' "$token_id" "$token_secret")
        unset token_id token_secret
        ;;
    telegram)
        target=/etc/kepler/telegram.env
        printf 'Telegram bot token: '
        IFS= read -r -s bot_token
        printf '\nTelegram chat ID: '
        IFS= read -r chat_id
        [[ "$bot_token" =~ ^[A-Za-z0-9:_-]+$ ]] || { echo "beklenmeyen bot token biçimi" >&2; exit 1; }
        [[ "$chat_id" =~ ^-?[0-9]+$ ]] || { echo "sayısal chat ID gerekli" >&2; exit 1; }
        content=$(printf 'TELEGRAM_BOT_TOKEN=%s\nTELEGRAM_CHAT_ID=%s\n' "$bot_token" "$chat_id")
        unset bot_token chat_id
        ;;
    *)
        echo "Kullanım: sudo kepler-configure-secret {modal|telegram}" >&2
        exit 2
        ;;
esac

umask 077
tmp=$(mktemp /etc/kepler/.env.XXXXXX)
trap 'rm -f "$tmp"' EXIT
printf '%s\n' "$content" > "$tmp"
unset content
chmod 600 "$tmp"
mv -f "$tmp" "$target"
trap - EXIT
echo "Gizli değerler yenilendi: ${target##*/} (root:root, 0600)"
