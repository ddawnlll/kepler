#!/usr/bin/python3
"""Root-owned fixed launcher. No shell, caller environment, caller paths or arbitrary commands."""
import json
import os
import re
import subprocess
import sys

args = sys.argv[1:]
if len(args) not in {2, 3} or args[0] not in {"run", "stop"} or not re.fullmatch(r"[0-9a-f]{32}", args[1]):
    raise SystemExit("geçersiz işlem/token")
os.environ.clear()
os.environ.update(PATH="/usr/bin:/bin", HOME="/root")
unit = "kepler-job-" + args[1]
if args[0] == "stop":
    if len(args) != 2:
        raise SystemExit("stop argümanları")
    # stop is idempotent; a missing unit has no surviving worker to fence.
    subprocess.run(["/usr/bin/systemctl", "stop", unit], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    live = subprocess.run(["/usr/bin/systemctl", "is-active", "--quiet", unit])
    raise SystemExit(1 if live.returncode == 0 else 0)
if len(args) != 3 or not re.fullmatch(r"[0-9a-f]{40}", args[2]):
    raise SystemExit("tam commit SHA gerekli")
policy = json.load(open("/etc/kepler/policy.json"))
tests = policy["required_tests"]
if not tests or any(not re.fullmatch(r"tests/test_[A-Za-z0-9_]+\.py", t) for t in tests):
    raise SystemExit("geçersiz zorunlu test politikası")
command = ["/usr/bin/systemd-run", "--quiet", "--wait", "--collect", "--pipe", "--unit=" + unit,
           "--uid=kworker", "--gid=kworker", "--service-type=exec",
           "--property=RuntimeDirectory=" + unit, "--property=RuntimeDirectoryMode=0700",
           "--property=WorkingDirectory=/run/" + unit,
           "--property=NoNewPrivileges=yes", "--property=PrivateTmp=yes", "--property=PrivateNetwork=yes",
           "--property=ProtectSystem=strict", "--property=ProtectHome=yes", "--property=ProtectKernelTunables=yes",
           "--property=ProtectKernelModules=yes", "--property=ProtectControlGroups=yes",
           "--property=ProtectProc=invisible", "--property=ProcSubset=pid", "--property=PrivateDevices=yes",
           "--property=RestrictSUIDSGID=yes", "--property=CapabilityBoundingSet=",
           "--property=RestrictAddressFamilies=AF_UNIX", "--property=KillMode=control-group",
           "--property=MemoryMax=4G", "--property=TasksMax=256", "--property=CPUQuota=200%",
           "--property=RuntimeMaxSec=" + str(policy["timeout_seconds"]),
           "--property=BindReadOnlyPaths=/srv/kepler.git:/input/repo.git /opt/kepler/venv:/opt/venv",
           "--property=InaccessiblePaths=/srv /home /root /etc/kepler /run/kepler",
           "--setenv=HOME=/run/" + unit, "--setenv=PYTHONNOUSERSITE=1",
           "/opt/venv/bin/python", "-I", "/usr/local/libexec/kepler-sandbox-worker", args[2], *tests]
raise SystemExit(subprocess.run(command).returncode)
